    "usage": {
      "title": "提前 (tíqián) - ကြိုတင် / အချိန်စော၍ / သတ်မှတ်ချိန်ထက်စောသော",
      "meaning": "သတ်မှတ်ထားသော အချိန်ထက် စောစီးစွာ လုပ်ဆောင်ခြင်း သို့မဟုတ် အချိန်ကို ရှေ့တိုးလိုက်ခြင်း (In advance/Ahead of time)။",
      "grammar_pattern": "提前 + Verb / 提前 + Time",
      "daily_examples": [
        {
          "label": "ကြိုတင်",
          "chinese": "提前",
          "pinyin": "Tíqián",
          "myanmar": "ကြိုတင်၍ (သို့) အချိန်စော၍"
        },
        {
          "label": "ကြိုတင် အကြောင်းကြားသည်",
          "chinese": "提前通知",
          "pinyin": "Tíqián tōngzhī",
          "myanmar": "ကြိုတင် အသိပေး အကြောင်းကြားသည်"
        },
        {
          "label": "အချိန်စောပြီး ရောက်သည်",
          "chinese": "提前到达",
          "pinyin": "Tíqián dàodá",
          "myanmar": "သတ်မှတ်ချိန်ထက် စောပြီး ရောက်ရှိသည်"
        },
        {
          "label": "၁၀ မိနစ် ကြိုလုပ်သည်",
          "chinese": "提前十分钟",
          "pinyin": "Tíqián shí fēnzhōng",
          "myanmar": "၁၀ မိနစ်လောက် ကြိုတင် (စောပြီး) လုပ်သည်"
        },
        {
          "label": "အစီအစဉ်ကို ရှေ့တိုးသည်",
          "chinese": "提前计划",
          "pinyin": "Tíqián jìhuà",
          "myanmar": "အစီအစဉ်ကို ကြိုတင် ပြင်ဆင်သည်"
        }
      ],
      "work_examples": [
        {
          "chinese": "由于天气原因，我们的会议提前结束了。",
          "pinyin": "Yóuyú tiānqì yuányīn, wǒmen de huìyì tíqián jiéshù le.",
          "myanmar": "ရာသီဥတု အခြေအနေကြောင့်၊ ကျွန်တော်တို့ရဲ့ အစည်းအဝေးက သတ်မှတ်ချိန်ထက် စောပြီး ပြီးဆုံးသွားခဲ့ပါတယ်။"
        },
        {
          "chinese": "为了不堵车，我决定明天提前半小时出发。",
          "pinyin": "Wèile bù dǔchē, wǒ juédìng míngtiān tíqián bàn xiǎoshí chūfā.",
          "myanmar": "ကားမပိတ်အောင်လို့၊ ကျွန်တော် မနက်ဖြန် နာရီဝက်လောက် စောပြီး ထွက်ဖို့ ဆုံးဖြတ်လိုက်ပါတယ်။"
        }
      ]
    }
