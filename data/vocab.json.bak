    "word": "忍耐",
    "pinyin": "rěnnài",
    "myanmar": "သည်းခံသော / အောင့်အည်းသည်းခံသော / စိတ်ရှည်သော",
    "hsk_level": 5,
    "usage": {
      "title": "忍耐 (rěnnài) - သည်းခံခြင်း (Patience/Endurance)",
      "meaning": "နာကျင်မှု၊ အခက်အခဲ သို့မဟုတ် ဒေါသတို့ကို စိတ်ရှည်စွာဖြင့် အောင့်အည်းလက်ခံခြင်း။",
      "grammar_pattern": "ကြိယာ အဖြစ် သုံးသည်",
      "daily_examples": [
        {
          "label": "သည်းခံမှု",
          "chinese": "面对挑衅，他表现出了极大的忍耐。",
          "pinyin": "ရန်စတာတွေကို ကြုံရပေမယ့် သူက အရမ်းကို သည်းခံ (忍耐) ခဲ့ပါတယ်။",
          "myanmar": "Miànduì tiǎoxìn, tā biǎoxiàn-chū le jídà de rěnnài."
        },
        {
          "label": "အခြေအနေ",
          "chinese": "忍耐并不是懦弱，而是一种成熟的表现。",
          "pinyin": "သည်းခံတာက ကြောက်တာမဟုတ်ဘူး၊ ဒါဟာ ရင့်ကျက်တဲ့ အမူအရာ တစ်ခုပါ။",
          "myanmar": "Rěnnài bìng bùshì nuòruò, ér shì yī zhǒng chéngshú de biǎoxiàn."
        },
        {
          "label": "နှိုင်းယှဉ်ချက်",
          "chinese": "比起冲动，忍耐的智慧能避免很多麻烦。",
          "pinyin": "စိတ်လိုက်မာန်ပါ လုပ်တာထက်စာရင် သည်းခံတဲ့ ဉာဏ်က ပြဿနာတွေ အများကြီးကို ရှောင်လွှဲနိုင်စေပါတယ်။",
          "myanmar": "Bǐqǐ chōngdòng, rěnnài de zhìhuì néng bìmiǎn hěnduō máfan."
        },
        {
          "label": "ရလဒ်",
          "chinese": "由于他的忍耐，这场冲突最终没有升级。",
          "pinyin": "သူက သည်းခံခဲ့လို့ ဒီပဋိပက္ခက ပိုပြီး ကြီးမားမလာခဲ့တာပါ။",
          "myanmar": "Yóuyú tā de rěnnài, zhè chǎng chōngtū zuìzhōng méiyǒu shēngjí."
        },
        {
          "label": "ပြောင်းလဲမှု",
          "chinese": "我们要学会在逆境中保持必要的忍耐力。",
          "pinyin": "Wǒmen yào xuéhuì zài nìjìng zhōng bǎochí bìyào de rěnnàilì.",
          "myanmar": "ငါတို့က အဆင်မပြေတဲ့ အခြေအနေတွေမှာ လိုအပ်တဲ့ သည်းခံနိုင်စွမ်း ရှိဖို့ သင်ယူရမယ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "在职业发展初期，往往需要一段时间的等待和忍耐。",
          "pinyin": "အလုပ်အကိုင် အစပိုင်းမှာတော့ စောင့်ဆိုင်းခြင်းနဲ့ သည်းခံခြင်းတွေ အများကြီး လိုအပ်တတ်ပါတယ်။",
          "myanmar": "Zài zhíyè fāzhǎn chūqī, wǎngwǎng xūyào yī duàn shíjiān de děngdài hé rěnnài."
        },
        {
          "chinese": "处理复杂的人际关系尤其需要忍耐和技巧。",
          "pinyin": "ရှုပ်ထွေးတဲ့ လူမှုဆက်ဆံရေးတွေကို ကိုင်တွယ်တဲ့အခါ သည်းခံမှုနဲ့ နည်းပရိယာယ်တွေ ပိုလိုအပ်ပါတယ်။",
          "myanmar": "Chǔlǐ fùzá de rénjì guānxì yóuqí xūyào rěnnài hé jìqiǎo."
        }
      ]
    }
  },
  {
    "id": 1940,
    "word": "荣誉",
    "pinyin": "róngyù",
    "myanmar": "ဂုဏ် / ဂုဏ်သိက္ခာ / ချီးမြှောက်ခြင်း",
    "hsk_level": 5,
    "usage": {
      "title": "荣誉 (róngyù) - ဂုဏ် (Honor/Glory)",
      "meaning": "လူတစ်ဦး သို့မဟုတ် အဖွဲ့အစည်းတစ်ခု၏ ကောင်းမွန်သော ဂုဏ်သတင်း သို့မဟုတ် ချီးမြှောက်ခြင်းခံရခြင်း။",
      "grammar_pattern": "နာမ် အဖြစ် သုံးသည်",
      "daily_examples": [
        {
          "label": "ဂုဏ်",
          "chinese": "获得这个奖项是我的无上荣誉。",
          "pinyin": "Huòdé zhège jiǎngxiàng shì wǒ de wúshàng róngyù.",
          "myanmar": "ဒီဆုကို ရတာက ကျွန်တော့်အတွက် အမြင့်မြတ်ဆုံး ဂုဏ် (荣誉) ပါပဲ။"
        },
        {
          "label": "အခြေအနေ",
          "chinese": "为国争光是军人的最高荣誉。",
          "pinyin": "နိုင်ငံအတွက် ဂုဏ်ဆောင်တာက စစ်သားတစ်ယောက်ရဲ့ အမြင့်ဆုံး ဂုဏ်သိက္ခာပါပဲ။",
          "myanmar": "Wèi guó zhēngguāng shì jūnrén de zuìgāo róngyù."
        },
        {
          "label": "နှိုင်းယှဉ်ချက်",
          "chinese": "比起金钱，荣誉更能激励人们不断前进。",
          "pinyin": "ပိုက်ဆံထက်စာရင် ဂုဏ်သိက္ခာက လူတွေကို ရှေ့ဆက်တိုးဖို့ ပိုပြီးတော့ တွန်းအားပေးပါတယ်။",
          "myanmar": "Bǐqǐ jīnqián, róngyù gèng néng jīlì rénmen bùduàn qiánjìn."
        },
        {
          "label": "ရလဒ်",
          "chinese": "由于他为集体赢得了荣誉，大家都对他非常敬佩。",
          "pinyin": "သူက အဖွဲ့အစည်းအတွက် ဂုဏ်ဆောင်ပေးခဲ့လို့ အားလုံးက သူ့ကို အရမ်း လေးစားကြတယ်။",
          "myanmar": "Yóuyú tā wèi jítǐ yíngdé le róngyù, dàjiā dōu duì tā fēicháng jìngpèi."
        },
        {
          "label": "ပြောင်းလဲမှု",
          "chinese": "我们要用自己的实际行动来捍卫集体的荣誉。",
          "pinyin": "Wǒmen yào yòng zìjǐ de shíyòng xíngdòng lái hànyuè jítǐ de róngyù.",
          "myanmar": "ငါတို့က ကိုယ့်ရဲ့ လက်တွေ့လုပ်ဆောင်မှုတွေနဲ့ အဖွဲ့အစည်းရဲ့ ဂုဏ်သိက္ခာကို ကာကွယ်ရမယ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "公司将授予他“年度优秀员工”的荣誉称号。",
          "pinyin": "ကုမ္ပဏီက သူ့ကို “တစ်နှစ်တာ အကောင်းဆုံး ဝန်ထမ်း” ဆိုတဲ့ ဂုဏ်ထူးဆောင်ဘွဲ့ကို ချီးမြှင့်မှာပါ။",
          "myanmar": "Gōngsī jiāng shòuyǔ tā “niándù yōuxiù yuángōng” de róngyù chēnghào."
        },
        {
          "chinese": "维护企业的声誉和荣誉是每个员工的责任。",
          "pinyin": "လုပ်ငန်းရဲ့ နာမည်ကောင်းနဲ့ ဂုဏ်သိက္ခာကို ထိန်းသိမ်းဖို့က ဝန်ထမ်းတိုင်းရဲ့ တာဝန်ပါ။",
          "myanmar": "Wéihù qǐyè de shēngyù hé róngyù shì měi gè yuángōng de zérèn."
        }
      ]
    }
