  {
    "id": 241,
    "word": "如果",
    "pinyin": "rúguǒ",
    "myanmar": "အကယ်၍",
    "hsk_level": 2,
    "usage": {
      "title": "如果 (rúguǒ) - အကယ်၍",
      "meaning": "အကယ်၍ (if) - အခြေအနေတစ်ခု သို့မဟုတ် ဖြစ်နိုင်ခြေတစ်ခုကို ဖော်ပြရန်။",
      "grammar_pattern": "如果 + condition, then + result",
      "daily_examples": [
        {
          "label": "အကယ်၍",
          "chinese": "如果下雨，就不去了。",
          "pinyin": "Rúguǒ xiàyǔ, jiù bù qù le.",
          "myanmar": "အကယ်၍ မိုးရွာရင် မသွားတော့ဘူး။"
        },
        {
          "label": "မသိ",
          "chinese": "如果你不知道，就问。",
          "pinyin": "Rúguǒ nǐ bù zhīdào, jiù wèn.",
          "myanmar": "မင်းမသိရင် မေးပါ။"
        },
        {
          "label": "ဖြစ်နိုင်",
          "chinese": "如果可以的话。",
          "pinyin": "Rúguǒ kěyǐ de huà.",
          "myanmar": "ဖြစ်နိုင်ရင်။"
        },
        {
          "label": "မလာ",
          "chinese": "如果他不来，怎么办？",
          "pinyin": "Rúguǒ tā bù lái, zěnme bàn?",
          "myanmar": "သူမလာရင် ဘယ်လိုလုပ်မလဲ?"
        },
        {
          "label": "မှန်",
          "chinese": "如果这是真的。",
          "pinyin": "Rúguǒ zhè shì zhēn de.",
          "myanmar": "ဒါသာ မှန်ကန်ရင်။"
        }
      ],
      "work_examples": [
        {
