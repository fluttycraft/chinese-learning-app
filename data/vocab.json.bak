      "title": "面向 (miànxiàng) - မျက်နှာမူသည် / ဦးတည်သည် / ရည်ရွယ်သည်",
      "meaning": "တစ်စုံတစ်ခု သို့မဟုတ် တစ်ဦးတစ်ယောက်ဆီသို့ မျက်နှာမူခြင်း (သို့မဟုတ်) အဖွဲ့အစည်းတစ်ခုခုကို ရည်ရွယ်၍ ဆောင်ရွက်ခြင်း။",
      "grammar_pattern": "面向 + target = \"... ကို ဦးတည်သော / ရည်ရွယ်သော\"",
      "daily_examples": [
        {
          "label": "နေရာ",
          "chinese": "大门面向大海。",
          "pinyin": "Dàmén miànxiàng dàhǎi.",
          "myanmar": "တံခါးမကြီးက ပင်လယ်ဘက်ကို မျက်နှာမူထားတယ်။"
        },
        {
          "label": "အနာဂတ်",
          "chinese": "面向未来，我们要有信心。",
          "myanmar": "အနာဂတ်ကို ရှေးရှုပြီး ငါတို့မှာ ယုံကြည်မှု ရှိရမယ်။",
          "pinyin": "Miànxiàng wèilái, wǒmen yào yǒu xìnxīn."
        },
        {
          "label": "ပညာရေး",
          "chinese": "面向全体学生的教育。",
          "myanmar": "ကျောင်းသားအားလုံးကို ဦးတည်တဲ့ (ခြုံငုံတဲ့) ပညာရေး။",
          "pinyin": "Miànxiàng quántǐ xuésheng de jiàoyù."
        },
        {
          "label": "လောက",
          "chinese": "面向世界，改革开放。",
          "myanmar": "ကမ္ဘာကြီးကို မျက်နှာမူပြီး ပြုပြင်ပြောင်းလဲမှုတွေ လုပ်တယ်။",
          "pinyin": "Miànxiàng shìjiè, gǎigé kāifàng."
        },
        {
          "label": "ရည်ရွယ်မှု",
          "chinese": "面向普通大众的节目。",
          "pinyin": "Miànxiàng pǔtōng dàzhòng de jiémù.",
          "myanmar": "သာမန်လူထုကို ရည်ရွယ်တဲ့ (Public) အစီအစဉ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "这款软件是面向年轻人的。",
          "pinyin": "Zhè kuǎn ruǎnjiàn shì miànxiàng niánqīngrén de.",
          "myanmar": "ဒီဆော့ဖ်ဝဲက လူငယ်တွေကို ဦးတည် (Target) ထားတာပါ။"
        },
        {
          "chinese": "我们要坚持面向市场进行研发。",
          "pinyin": "Wǒmen yào jiānchí miànxiàng shìchǎng jìnxíng yánfā.",
