    "word": "即使",
    "pinyin": "jíshǐ",
    "myanmar": "ဆိုလျှင်တောင်",
    "hsk_level": 4,
    "usage": {
      "title": "即使 (jíshǐ) - ... ပေမယ့် / ... ဆိုရင်တောင်",
      "meaning": "အခြေအနေတစ်ခု ရှိနေသော်လည်း ရလဒ် ပြောင်းလဲမည် မဟုတ်ပေ (Even if/Even though)။",
      "grammar_pattern": "即使 ... 也 ...",
      "daily_examples": [
        {
          "label": "... တိုင်အောင်",
          "chinese": "即使",
          "pinyin": "Jíshǐ",
          "myanmar": "... ဆိုရင်တောင်"
        },
        {
          "label": "မိုးရွာပေမယ့်လည်း",
          "chinese": "即使下雨",
          "pinyin": "Jíshǐ xiàyǔ",
          "myanmar": "မိုးရွာရင်တောင်မှ"
        },
        {
          "label": "နားမလည်ပေမယ့်လည်း",
          "chinese": "即使不懂",
          "pinyin": "Jíshǐ bù dǒng",
          "myanmar": "နားမလည်ရင်တောင်မှ"
        },
        {
          "label": "ပင်ပန်းပေမယ့်လည်း",
          "chinese": "即使很累",
          "pinyin": "Jíshǐ hěn lèi",
          "myanmar": "ပင်ပန်းနေရင်တောင်မှ"
        },
        {
          "label": "ရှုံးနိမ့်ပေမယ့်လည်း",
          "chinese": "即使失败",
          "pinyin": "Jíshǐ shībài",
          "myanmar": "ရှုံးနိမ့်ခဲ့ရင်တောင်မှ"
        }
      ],
      "work_examples": [
        {
          "chinese": "即使明天由于天气原因无法出门，我也会在家好好复习。",
          "pinyin": "Jíshǐ míngtiān yóuyú tiānqì yuányīn wúfǎ chūmén, wǒ yě huì zài jiā hǎohǎo fùxí.",
          "myanmar": "မနက်ဖြန် ရာသီဥတုကြောင့် အပြင်မထွက်နိုင်ရင်တောင်မှ၊ ကျွန်တော် အိမ်မှာပဲ စာပြန်လုပ်နေမှာပါ။"
        },
        {
          "chinese": "即使成功了，也不应该骄傲。",
          "pinyin": "Jíshǐ chénggōng le, yě bù yīnggāi jiāo'ào.",
          "myanmar": "အောင်မြင်သွားရင်တောင်မှ၊ မာန်မာန မတက်သင့်ပါဘူး။"
        }
      ]
    }
  },
