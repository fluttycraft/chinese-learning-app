[
  {
    "id": 1,
    "word": "爱",
    "pinyin": "ài",
    "myanmar": "ချစ်သည်၊ ကြိုက်သည်၊ အချစ်",
    "hsk_level": 1,
    "usage": {
      "title": "爱 (ài) - ချစ်ခြင်း",
      "meaning": "ချစ်သည်၊ နှစ်သက်သည်။ လူကိုရော အရာဝတ္ထုကိုရော သုံးနိုင်တယ်။",
      "grammar_pattern": "爱 + နာမ် = \"... ကို ချစ်တယ်\"\n爱 + ကြိယာ = \"... လုပ်ရတာ ကြိုက်တယ်\"",
      "daily_examples": [
        {
          "label": "ချစ်ခြင်း",
          "chinese": "我爱你。",
          "pinyin": "Wǒ ài nǐ.",
          "myanmar": "ငါ မင်းကို ချစ်တယ်။"
        },
        {
          "label": "မိသားစု",
          "chinese": "我爱我的家人。",
          "pinyin": "Wǒ ài wǒ de jiārén.",
          "myanmar": "ငါ ငါ့မိသားစုကို ချစ်တယ်။"
        },
        {
          "label": "ဝါသနာ",
          "chinese": "她爱唱歌。",
          "pinyin": "Tā ài chànggē.",
          "myanmar": "သူမ သီချင်းဆိုရတာ ကြိုက်တယ်။"
        },
        {
          "label": "အစားအသောက်",
          "chinese": "我爱吃中国菜。",
          "pinyin": "Wǒ ài chī zhōngguó cài.",
          "myanmar": "ငါ တရုတ်ဟင်းစားရတာ ကြိုက်တယ်။"
        },
        {
          "label": "နိုင်ငံ",
          "chinese": "我爱中国。",
          "pinyin": "Wǒ ài zhōngguó.",
          "myanmar": "ငါ တရုတ်နိုင်ငံကို ချစ်တယ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "我爱我的工作。",
          "pinyin": "Wǒ ài wǒ de gōngzuò.",
          "myanmar": "ငါ ငါ့အလုပ်ကို ချစ်တယ်။"
        },
        {
          "chinese": "他很爱学习。",
          "pinyin": "Tā hěn ài xuéxí.",
          "myanmar": "သူ လေ့လာရတာ အရမ်းကြိုက်တယ်။"
        }
      ]
    }
  },
  {
    "id": 2,
    "word": "八",
    "pinyin": "bā",
    "myanmar": "ရှစ်၊ ၈",
    "hsk_level": 1,
    "usage": {
      "title": "八 (bā) - ရှစ်",
      "meaning": "ကိန်းဂဏန်း ရှစ် (၈)။ အရေအတွက်ဖော်ပြရာတွင် သုံးတယ်။",
      "grammar_pattern": "八 + measure word + နာမ်\n八 + 月 = \"ဩဂုတ်လ\"",
      "daily_examples": [
        {
          "label": "ကိန်းဂဏန်း",
          "chinese": "我有八本书。",
          "pinyin": "Wǒ yǒu bā běn shū.",
          "myanmar": "ငါ စာအုပ်ရှစ်အုပ်ရှိတယ်။"
        },
        {
          "label": "အချိန်",
          "chinese": "八点上课。",
          "pinyin": "Bā diǎn shàngkè.",
          "myanmar": "ရှစ်နာရီမှာ စာသင်တယ်။"
        },
        {
          "label": "လ",
          "chinese": "八月很热。",
          "pinyin": "Bā yuè hěn rè.",
          "myanmar": "ဩဂုတ်လ အရမ်းပူတယ်။"
        },
        {
          "label": "ရက်",
          "chinese": "八号是星期一。",
          "pinyin": "Bā hào shì xīngqī yī.",
          "myanmar": "ရှစ်ရက်နေ့က တနင်္လာနေ့ပါ။"
        },
        {
          "label": "အသက်",
          "chinese": "他八岁了。",
          "pinyin": "Tā bā suì le.",
          "myanmar": "သူ ရှစ်နှစ်ရှိပြီ။"
        }
      ],
      "work_examples": [
        {
          "chinese": "八点开会。",
          "pinyin": "Bā diǎn kāihuì.",
          "myanmar": "ရှစ်နာရီမှာ အစည်းအဝေးလုပ်မယ်။"
        },
        {
          "chinese": "我们有八个同事。",
          "pinyin": "Wǒmen yǒu bā gè tóngshì.",
          "myanmar": "ငါတို့ လုပ်ဖော်ကိုင်ဖက် ရှစ်ယောက်ရှိတယ်။"
        }
      ]
    }
  },
  {
    "id": 3,
    "word": "爸爸",
    "pinyin": "bàba",
    "myanmar": "အဖေ",
    "hsk_level": 1,
    "usage": {
      "title": "爸爸 (bàba) - အဖေ",
      "meaning": "အဖေ။ မိသားစုတွင် အဖေကို ခေါ်ဆိုသော စကားလုံး။",
      "grammar_pattern": "爸爸 + ကြိယာ = \"အဖေ ... လုပ်တယ်\"",
      "daily_examples": [
        {
          "label": "ခေါ်ဆိုခြင်း",
          "chinese": "爸爸，你好！",
          "pinyin": "Bàba, nǐ hǎo!",
          "myanmar": "အဖေ၊ မင်္ဂလာပါ!"
        },
        {
          "label": "ဖော်ပြခြင်း",
          "chinese": "我爸爸是老师。",
          "pinyin": "Wǒ bàba shì lǎoshī.",
          "myanmar": "ငါ့အဖေက ဆရာပါ။"
        },
        {
          "label": "လုပ်ဆောင်ချက်",
          "chinese": "爸爸在看书。",
          "pinyin": "Bàba zài kàn shū.",
          "myanmar": "အဖေ စာဖတ်နေတယ်။"
        },
        {
          "label": "ချစ်ခြင်း",
          "chinese": "我爱爸爸。",
          "pinyin": "Wǒ ài bàba.",
          "myanmar": "ငါ အဖေ့ကို ချစ်တယ်။"
        },
        {
          "label": "အလုပ်",
          "chinese": "爸爸每天工作。",
          "pinyin": "Bàba měitiān gōngzuò.",
          "myanmar": "အဖေ နေ့တိုင်း အလုပ်လုပ်တယ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "我爸爸在医院工作。",
          "pinyin": "Wǒ bàba zài yīyuàn gōngzuò.",
          "myanmar": "ငါ့အဖေ ဆေးရုံမှာ အလုပ်လုပ်တယ်။"
        },
        {
          "chinese": "爸爸今天很忙。",
          "pinyin": "Bàba jīntiān hěn máng.",
          "myanmar": "အဖေ ဒီနေ့ အရမ်းအလုပ်များတယ်။"
        }
      ]
    }
  },
  {
    "id": 4,
    "word": "杯子",
    "pinyin": "bēizi",
    "myanmar": "ခွက်",
    "hsk_level": 1,
    "usage": {
      "title": "杯子 (bēizi) - ခွက်",
      "meaning": "ခွက်၊ ဖန်ခွက်။ အရည်များသောက်ရာတွင် သုံးသော ပစ္စည်း။",
      "grammar_pattern": "一个杯子 = \"ခွက်တစ်လုံး\"\n一杯 + drink = \"... တစ်ခွက်\"",
      "daily_examples": [
        {
          "label": "တောင်းဆိုခြင်း",
          "chinese": "请给我一个杯子。",
          "pinyin": "Qǐng gěi wǒ yī gè bēizi.",
          "myanmar": "ကျေးဇူးပြု၍ ခွက်တစ်လုံးပေးပါ။"
        },
        {
          "label": "တည်နေရာ",
          "chinese": "杯子在桌子上。",
          "pinyin": "Bēizi zài zhuōzi shàng.",
          "myanmar": "ခွက်က စားပွဲပေါ်မှာ ရှိတယ်။"
        },
        {
          "label": "ဖော်ပြခြင်း",
          "chinese": "这个杯子很漂亮。",
          "pinyin": "Zhège bēizi hěn piàoliang.",
          "myanmar": "ဒီခွက်က အရမ်းလှတယ်။"
        },
        {
          "label": "ဝယ်ခြင်း",
          "chinese": "我要买一个杯子。",
          "pinyin": "Wǒ yào mǎi yī gè bēizi.",
          "myanmar": "ငါ ခွက်တစ်လုံး ဝယ်ချင်တယ်။"
        },
        {
          "label": "အရည်",
          "chinese": "杯子里有水。",
          "pinyin": "Bēizi lǐ yǒu shuǐ.",
          "myanmar": "ခွက်ထဲမှာ ရေရှိတယ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "请用这个杯子喝茶。",
          "pinyin": "Qǐng yòng zhège bēizi hē chá.",
          "myanmar": "ကျေးဇူးပြု၍ ဒီခွက်နဲ့ လက်ဖက်ရည်သောက်ပါ။"
        },
        {
          "chinese": "办公室的杯子是我的。",
          "pinyin": "Bàngōngshì de bēizi shì wǒ de.",
          "myanmar": "ရုံးခန်းထဲက ခွက်က ငါ့ဟာပါ။"
        }
      ]
    }
  },
  {
    "id": 5,
    "word": "北京",
    "pinyin": "běijīng",
    "myanmar": "ပေကျင်းမြို့",
    "hsk_level": 1,
    "usage": {
      "title": "北京 (běijīng) - ပေကျင်းမြို့",
      "meaning": "ပေကျင်းမြို့။ တရုတ်နိုင်ငံ၏ မြို့တော်။",
      "grammar_pattern": "在北京 = \"ပေကျင်းမှာ\"\n去北京 = \"ပေကျင်းကို သွားတယ်\"",
      "daily_examples": [
        {
          "label": "နေရာ",
          "chinese": "我在北京。",
          "pinyin": "Wǒ zài běijīng.",
          "myanmar": "ငါ ပေကျင်းမှာ ရှိတယ်။"
        },
        {
          "label": "ခရီးသွား",
          "chinese": "我想去北京。",
          "pinyin": "Wǒ xiǎng qù běijīng.",
          "myanmar": "ငါ ပေကျင်းကို သွားချင်တယ်။"
        },
        {
          "label": "ဖော်ပြခြင်း",
          "chinese": "北京很大。",
          "pinyin": "Běijīng hěn dà.",
          "myanmar": "ပေကျင်းက အရမ်းကြီးတယ်။"
        },
        {
          "label": "ရာသီဥတု",
          "chinese": "北京冬天很冷。",
          "pinyin": "Běijīng dōngtiān hěn lěng.",
          "myanmar": "ပေကျင်းမှာ ဆောင်းရာသီ အရမ်းအေးတယ်။"
        },
        {
          "label": "လူ",
          "chinese": "他是北京人。",
          "pinyin": "Tā shì běijīng rén.",
          "myanmar": "သူက ပေကျင်းသားပါ။"
        }
      ],
      "work_examples": [
        {
          "chinese": "公司在北京。",
          "pinyin": "Gōngsī zài běijīng.",
          "myanmar": "ကုမ္ပဏီက ပေကျင်းမှာ ရှိတယ်။"
        },
        {
          "chinese": "我去北京出差。",
          "pinyin": "Wǒ qù běijīng chūchāi.",
          "myanmar": "ငါ ပေကျင်းကို အလုပ်ကိစ္စသွားမယ်။"
        }
      ]
    }
  },
  {
    "id": 6,
    "word": "本",
    "pinyin": "běn",
    "myanmar": "အရာဝတ္ထုများ၊ စာအုပ် စသည်ကို ရေတွက်သော ကျောက်ကုတ်ဟောင်း ပုဒ်မ",
    "hsk_level": 1,
    "usage": {
      "title": "本 (běn) - ရေတွက်ပုဒ်မ (စာအုပ်)",
      "meaning": "စာအုပ်၊ မဂ္ဂဇင်း၊ စာစောင်များကို ရေတွက်ရာတွင် သုံးသော measure word။",
      "grammar_pattern": "数字 + 本 + 书/杂志 = \"စာအုပ် ... အုပ်\"",
      "daily_examples": [
        {
          "label": "စာအုပ်",
          "chinese": "我有三本书。",
          "pinyin": "Wǒ yǒu sān běn shū.",
          "myanmar": "ငါ စာအုပ်သုံးအုပ်ရှိတယ်။"
        },
        {
          "label": "ဝယ်ခြင်း",
          "chinese": "我买了一本书。",
          "pinyin": "Wǒ mǎi le yī běn shū.",
          "myanmar": "ငါ စာအုပ်တစ်အုပ် ဝယ်ခဲ့တယ်။"
        },
        {
          "label": "မေးခြင်း",
          "chinese": "你有几本书？",
          "pinyin": "Nǐ yǒu jǐ běn shū?",
          "myanmar": "မင်း စာအုပ်ဘယ်နှစ်အုပ်ရှိလဲ?"
        },
        {
          "label": "ပေးခြင်း",
          "chinese": "给你这本书。",
          "pinyin": "Gěi nǐ zhè běn shū.",
          "myanmar": "မင်းကို ဒီစာအုပ် ပေးတယ်။"
        },
        {
          "label": "မဂ္ဂဇင်း",
          "chinese": "我看了两本杂志。",
          "pinyin": "Wǒ kàn le liǎng běn zázhì.",
          "myanmar": "ငါ မဂ္ဂဇင်းနှစ်အုပ် ဖတ်ခဲ့တယ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "这本书很有用。",
          "pinyin": "Zhè běn shū hěn yǒuyòng.",
          "myanmar": "ဒီစာအုပ်က အရမ်းအသုံးဝင်တယ်။"
        },
        {
          "chinese": "请给我看那本报告。",
          "pinyin": "Qǐng gěi wǒ kàn nà běn bàogào.",
          "myanmar": "ကျေးဇူးပြု၍ ဟိုအစီရင်ခံစာ ပြပါ။"
        }
      ]
    }
  },
  {
    "id": 7,
    "word": "不客气",
    "pinyin": "bú kèqi",
    "myanmar": "အားမနာပါနဲ့၊ ကြိုဆိုပါတယ်",
    "hsk_level": 1,
    "usage": {
      "title": "不客气 (bú kèqi) - အားမနာပါနဲ့",
      "meaning": "ကျေးဇူးတင်ကြောင်းအား ပြန်ဆိုသောစကား။ 'You're welcome' ဟူသောအဓိပ္ပါယ်ရတယ်။",
      "grammar_pattern": "谢谢 → 不客气 = \"ကျေးဇူးတင်ပါတယ် → အားမနာပါနဲ့\"",
      "daily_examples": [
        {
          "label": "ဖြေဆိုခြင်း",
          "chinese": "谢谢你！不客气。",
          "pinyin": "Xièxie nǐ! Bú kèqi.",
          "myanmar": "ကျေးဇူးတင်ပါတယ်! အားမနာပါနဲ့။"
        },
        {
          "label": "ကူညီပြီး",
          "chinese": "帮了你，不客气。",
          "pinyin": "Bāng le nǐ, bú kèqi.",
          "myanmar": "ကူညီပြီး အားမနာပါနဲ့။"
        },
        {
          "label": "ယဉ်ကျေးသော",
          "chinese": "不客气，这是我应该做的。",
          "pinyin": "Bú kèqi, zhè shì wǒ yīnggāi zuò de.",
          "myanmar": "အားမနာပါနဲ့၊ ဒါ ငါ လုပ်သင့်တာပဲ။"
        },
        {
          "label": "မိတ်ဆက်",
          "chinese": "谢谢你的帮助！不客气。",
          "pinyin": "Xièxie nǐ de bāngzhù! Bú kèqi.",
          "myanmar": "မင်းရဲ့ အကူအညီကို ကျေးဇူးတင်ပါတယ်! အားမနာပါနဲ့။"
        },
        {
          "label": "ပုံမှန်",
          "chinese": "A: 谢谢！B: 不客气！",
          "pinyin": "A: Xièxie! B: Bú kèqi!",
          "myanmar": "A: ကျေးဇူးတင်ပါတယ်! B: အားမနာပါနဲ့!"
        }
      ],
      "work_examples": [
        {
          "chinese": "谢谢你的帮忙！不客气。",
          "pinyin": "Xièxie nǐ de bāngmáng! Bú kèqi.",
          "myanmar": "ကူညီပေးတဲ့အတွက် ကျေးဇူးတင်ပါတယ်! အားမနာပါနဲ့။"
        },
        {
          "chinese": "不客气，随时可以找我。",
          "pinyin": "Bú kèqi, suíshí kěyǐ zhǎo wǒ.",
          "myanmar": "အားမနာပါနဲ့၊ ဘယ်တော့မဆို ငါ့ကို လာခေါ်လို့ရတယ်။"
        }
      ]
    }
  },
  {
    "id": 8,
    "word": "不",
    "pinyin": "bù",
    "myanmar": "မ...ဘူး",
    "hsk_level": 1,
    "usage": {
      "title": "不 (bù) - ငြင်းဆန်ခြင်း",
