      "meaning": "မမျှော်လင့်ထားသော ကိစ္စတစ်ခု ဖြစ်ပျက်ခြင်းကို ပြသသည် (Unexpectedly/To one's surprise)။",
      "grammar_pattern": "Subject + 竟然 + Verb",
      "daily_examples": [
        {
          "label": "မထင်မှတ်ဘဲ",
          "chinese": "竟然",
          "pinyin": "Jìngrán",
          "myanmar": "မထင်မှတ်ဘဲ (သို့) ထင်မှတ်မထားတာ"
        },
        {
          "label": "မေ့သွားတယ်",
          "chinese": "竟然忘了",
          "pinyin": "Jìngrán wàng le",
          "myanmar": "မထင်မှတ်ဘဲ မေ့သွားခဲ့တယ်"
        },
        {
          "label": "ဒီလောက်တောင် ဈေးကြီးတာလား",
          "chinese": "竟然这么贵",
          "pinyin": "Jìngrán zhème guì",
          "myanmar": "မထင်မှတ်ဘဲ ဒီလောက်တောင် ဈေးကြီးတာလား"
        },
        {
          "label": "လာခဲ့တယ်",
          "chinese": "竟然来了",
          "pinyin": "Jìngrán lái le",
          "myanmar": "မထင်မှတ်ဘဲ ရောက်လာခဲ့တယ်"
        },
        {
          "label": "မသိဘူး",
          "chinese": "竟然不知道",
          "pinyin": "Jìngrán bù zhīdào",
          "myanmar": "မထင်မှတ်ဘဲ မသိဘဲ ဖြစ်နေတယ်"
        }
      ],
      "work_examples": [
        {
          "chinese": "他竟然没认出我是谁。",
          "pinyin": "Tā jìngrán méi rèn chū wǒ shì shéi.",
          "myanmar": "သူက ကျွန်တော် ဘယ်သူလဲဆိုတာကို မထင်မှတ်ဘဲ မမှတ်မိဘူး ဖြစ်နေပါတယ်။"
