  {
    "id": 1941,
    "word": "如履薄冰",
    "pinyin": "rúlǚ bóbīng",
    "myanmar": "သတိနှင့် ဆောင်ရွက်သည်",
    "hsk_level": 5,
    "usage": {
      "title": "如履薄冰 (rúlǚ bóbīng) - သတိနှင့် ဆောင်ရွက်ခြင်း (Treading on thin ice)",
      "meaning": "အလွန်ပါးလွှာသော ရေခဲပြင်ပေါ်တွင် လမ်းလျှောက်နေသကဲ့သို့ အလွန်တရာ သတိထားပြီး စိုးရိမ်စိတ်ဖြင့် ဆောင်ရွက်ခြင်း။",
      "grammar_pattern": "လေးလုံးတွဲ စကားပုံ (Idiom) / ကြိယာ အဖြစ် သုံးသည်",
      "daily_examples": [
        {
          "label": "သတိထားမှု",
          "chinese": "处理这件事，他感到如履薄冰。",
          "pinyin": "Chǔlǐ zhè jiàn shì, tā gǎndào rúlǚ-bóbīng.",
          "myanmar": "ဒီကိစ္စကို ကိုင်တွယ်ရာမှာ သူက ရေခဲပါးပေါ် လျှောက်နေရသလို (如履薄冰) အလွန် သတိထားနေရတယ်။"
        },
        {
          "label": "အခြေအနေ",
          "chinese": "在目前的局势下，每一步都要走得如履薄冰。",
          "pinyin": "Zài mùqián de júshì xià, měi yī bù dōu yào zǒu de rúlǚ-bóbīng.",
          "myanmar": "အခုလို အခြေအနေမျိုးမှာ ခြေလှမ်းတိုင်းကို အရမ်း သတိထားပြီး လှမ်းရမယ်။"
        },
        {
          "label": "နှိုင်းယှဉ်ချက်",
          "chinese": "比起粗心大意，如履薄冰的态度更稳妥。",
          "pinyin": "ပေါ့ပေါ့တန်တန် လုပ်တာထက် အလွန် သတိထားတဲ့ စိတ်ထားက ပိုပြီး စိတ်ချရပါတယ်။",
          "myanmar": "Bǐqǐ cūxīn-dàyì, rúlǚ-bóbīng de tàidù gèng wěntuǒ."
        },
        {
          "label": "ရလဒ်",
          "chinese": "由于做到了如履薄冰，他最终平安渡过了难关。",
          "pinyin": "အရမ်း သတိထားခဲ့လို့ သူက နောက်ဆုံးမှာ အခက်အခဲတွေကို ဘေးကင်းကင်းနဲ့ ကျော်ဖြတ်နိုင်ခဲ့တယ်။",
          "myanmar": "Yóuyú zuò-dào le rúlǚ-bóbīng, tā zuìzhōng píng'ān dùguò le nánguān."
        },
        {
          "label": "ပြောင်းလဲမှု",
          "chinese": "我们要学会在危险面前保持如履薄冰的谨慎。",
          "pinyin": "Wǒmen yào xuéhuì zài wēixiǎn miànqián bǎochí rúlǚ-bóbīng de jǐnshèn.",
          "myanmar": "ဘေးအန္တရာယ်တွေရှေ့မှာ အရမ်း သတိကြီးစွာ ထားတတ်ဖို့ ငါတို့ သင်ယူရမယ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "作为财务主管，他对每一笔大额支出都感到如履薄冰。",
          "pinyin": "ဘဏ္ဍာရေးမှူးတစ်ယောက်အနေနဲ့ ကြီးမားတဲ့ အသုံးစရိတ်တိုင်းအတွက် သူက အရမ်း သတိထား (စိုးရိမ်) နေရပါတယ်။",
          "myanmar": "Zuòwéi cáiwù zhǔguǎn, tā duì měi yī bǐ dà'é zhīchū dōu gǎndào rúlǚ-bóbīng."
        },
        {
          "chinese": "该项目风险极大，团队成员必须如履薄冰地推进。",
          "pinyin": "ဒီစီမံကိန်းက အန္တရာယ် အရမ်းများလို့ အဖွဲ့ဝင်တွေ အားလုံးက အရမ်း သတိထားပြီး လုပ်ဆောင်ရမှာ ဖြစ်ပါတယ်။",
          "myanmar": "Gāi xiàngmù fēngxiǎn jídà, tuánduì chéngyuán bìxū rúlǚ-bóbīng de tuījìn."
        }
      ]
    }
  },
  {
    "id": 1942,
    "word": "锐意",
    "pinyin": "ruìyì",
    "myanmar": "ဆန်းသစ်သော",
    "hsk_level": 5,
    "usage": {
      "title": "锐意 (ruìyì) - ဆန်းသစ်လိုသောစိတ် (Determined/Enterprising)",
      "meaning": "တစ်ခုခုကို ပြုပြင်ပြောင်းလဲရန် သို့မဟုတ် တိုးတက်အောင်လုပ်ရန် ပြင်းပြသောဆန္ဒရှိခြင်း။",
      "grammar_pattern": "ကြိယာဝိသေသန / နာမ် အဖြစ် သုံးသည်",
