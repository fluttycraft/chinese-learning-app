          "myanmar": "ဆံပင်ညှပ်သည်။"
        },
        {
          "label": "ဆံပင်လျှော်သည်",
          "chinese": "洗头发。",
          "pinyin": "Xǐ tóufa.",
          "myanmar": "ဆံပင်လျှော်သည်။"
        },
        {
          "label": "ဆံပင်ရှည်သည်",
          "chinese": "长头发。",
          "pinyin": "Cháng tóufa.",
          "myanmar": "ဆံပင်ရှည်။"
        },
        {
          "label": "ဆံပင်တိုသည်",
          "chinese": "短头发。",
          "pinyin": "Duǎn tóufa.",
          "myanmar": "ဆံပင်တို။"
        },
        {
          "label": "ဆံပင်ဖြီးသည်",
          "chinese": "梳头发。",
          "pinyin": "Shū tóufa.",
          "myanmar": "ဆံပင်ဖြီးသည်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "她的头发黑黑的，很好看。",
