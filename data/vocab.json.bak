    "myanmar": "လွတ်လပ်စွာ / ကိုယ်ပိုင်ဆုံးဖြတ်ခွင့်ရှိသော / မိမိဘာသာ ရပ်တည်သော",
    "hsk_level": 5,
    "usage": {
      "title": "独立自主 (dúlì zìzhǔ) - လွတ်လပ်စွာ / ကိုယ်ပိုင်ဆုံးဖြတ်ခွင့်ရှိခြင်း (Independent and autonomous)",
      "meaning": "အခြားသူ သို့မဟုတ် အခြားအဖွဲ့အစည်း၏ လွှမ်းမိုးမှုမရှိဘဲ မိမိဘာသာ ဆုံးဖြတ်ချက်ချပြီး လုပ်ဆောင်ခြင်း။",
      "grammar_pattern": "လေးလုံးတွဲ စကားပုံ (Idiom) / နာမဝိသေသန အဖြစ် သုံးသည်",
      "daily_examples": [
        {
          "label": "နိုင်ငံရေး",
          "chinese": "走独立自主的发展道路。",
          "pinyin": "Zǒu dúlì-zìzhǔ de fāzhǎn dàolù.",
          "myanmar": "လွတ်လပ်စွာ ကိုယ်ပိုင်ဆုံးဖြတ်ခွင့်ရှိတဲ့ ဖွံ့ဖြိုးတိုးတက်မှု လမ်းစဉ်ကို လျှောက်လှမ်းတယ်။"
        },
        {
          "label": "အတွေးအခေါ်",
          "chinese": "我们要培养孩子独立自主的能力。",
          "pinyin": "Wǒmen yào péiyǎng háizi dúlì-zìzhǔ de nénglì.",
          "myanmar": "ငါတို့က ကလေးတွေကို မိမိဘာသာ ရပ်တည်နိုင်တဲ့ (ကိုယ်ပိုင်ဆုံးဖြတ်နိုင်တဲ့) အရည်အချင်းရှိအောင် သင်ပေးရမယ်။"
        },
        {
          "label": "နှိုင်းယှဉ်ချက်",
          "chinese": "他是一个非常独立自主的人。",
          "pinyin": "သူက အရမ်းကို ကိုယ့်ခြေထောက်ပေါ်ကိုယ်ရပ်တည်တဲ့ (လွတ်လပ်တဲ့) သူတစ်ယောက်ပါ။",
          "myanmar": "Tā shì yī gè fēicháng dúlì-zìzhǔ de rén."
        },
        {
          "label": "ရလဒ်",
          "chinese": "坚持独立自主的原则。",
          "pinyin": "Jiānchí dúlì-zìzhǔ de yuánzé.",
          "myanmar": "လွတ်လပ်စွာ ကိုယ်ပိုင်ဆုံးဖြတ်ခွင့်ရှိတဲ့ မူဝါဒကို စွဲကိုင်ထားတယ်။"
        },
        {
          "label": "ပြောင်းလဲမှု",
          "chinese": "要想获得真正的自由，就必须学会独立自主。",
          "pinyin": "တကယ့်လွတ်လပ်မှုကို ရချင်ရင် ကိုယ်တိုင်ရပ်တည်တတ်အောင် သင်ယူရမယ်။",
          "myanmar": "Yào xiǎng huòdé zhēnzhèng de zìyóu, jiù bìxū xuéhuì dúlì-zìzhǔ."
        }
      ],
      "work_examples": [
        {
          "chinese": "在研发核心技术时，我们必须坚持独立自主的方针。",
          "pinyin": "အဓိက နည်းပညာတွေကို သုတေသနလုပ်တဲ့အခါမှာ ငါတို့က ကိုယ်ပိုင်ရပ်တည်နိုင်တဲ့ (အမှီအခိုကင်းတဲ့) မူဝါဒကို စွဲကိုင်ရပါမယ်။",
          "myanmar": "Zài yánfā héxīn jìshù shí, wǒmen bìxū jiānchí dúlì-zìzhǔ de fāngzhēn."
        },
        {
          "chinese": "公司的决策过程是非常独立自主的，不收任何外部团体的干预。",
          "pinyin": "ကုမ္ပဏီရဲ့ ဆုံးဖြတ်ချက်ချတဲ့ လုပ်ငန်းစဉ်က အရမ်းကို လွတ်လပ်ပါတယ်၊ ဘယ်ပြင်ပ အဖွဲ့အစည်းရဲ့ စွက်ဖက်မှုကိုမှ မခံပါဘူး။",
          "myanmar": "Gōngsī de juécè guòchéng shì fēicháng dúlì-zìzhǔ de, bù shōu rènhé wàibù tuántǐ de gānyù."
        }
      ]
    }
