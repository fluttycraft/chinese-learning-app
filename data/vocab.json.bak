  {
    "id": 402,
    "word": "或者",
    "pinyin": "huòzhě",
    "myanmar": "သို့မဟုတ်",
    "hsk_level": 3,
    "usage": {
      "title": "或者 (huòzhě) - သို့မဟုတ်",
      "meaning": "သို့မဟုတ် (or) - နှစ်ခုအနက် တစ်ခု (ဝါကျရိုးတွင်သုံးသည်)။",
      "grammar_pattern": "A + 或者 + B",
      "daily_examples": [
        {
          "label": "ဒါမှမဟုတ်",
          "chinese": "你也去，或者他也去。",
          "pinyin": "Nǐ yě qù, huòzhě tā yě qù.",
          "myanmar": "မင်းပဲသွားသွား၊ သူပဲသွားသွား။"
        },
        {
          "label": "လက်ဖက်ရည်",
          "chinese": "喝茶或者喝水。",
          "pinyin": "Hē chá huòzhě hē shuǐ.",
          "myanmar": "လက်ဖက်ရည် သောက်မလား၊ ရေ သောက်မလား (တစ်ခုသောက်မယ်)။"
        },
        {
          "label": "ဒီနေ့",
          "chinese": "今天或者明天。",
          "pinyin": "Jīntiān huòzhě míngtiān.",
          "myanmar": "ဒီနေ့ သို့မဟုတ် မနက်ဖြန်။"
        },
        {
          "label": "အိမ်မှာ",
          "chinese": "在家或者在公司。",
          "pinyin": "Zài jiā huòzhě zài gōngsī.",
          "myanmar": "အိမ်မှာ (သို့) ရုံးမှာ။"
        },
        {
          "label": "ဖုန်း",
          "chinese": "打电话或者发短信。",
          "pinyin": "Dǎ diànhuà huòzhě fā duǎnxìn.",
          "myanmar": "ဖုန်းဆက်မယ် ဒါမှမဟုတ် စာပို့မယ်။"
        }
      ],
      "work_examples": [
        {
          "chinese": "您可以刷卡或者付现金。",
          "pinyin": "Nín kěyǐ shuākǎ huòzhě fù xiànjīn.",
          "myanmar": "ကတ်ဆွဲလို့ရတယ် သို့မဟုတ် ငွေသားပေးလို့ရတယ်။"
        },
        {
          "chinese": "由经理或者主管签字。",
          "pinyin": "Yóu jīnglǐ huòzhě zhǔguǎn qiānzì.",
          "myanmar": "မန်နေဂျာ (သို့) ကြီးကြပ်ရေးမှူး လက်မှတ်ထိုးရမယ်။"
        }
      ]
    }
  },
