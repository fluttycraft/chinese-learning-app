    "pinyin": "péngyou zhīdào",
    "myanmar": "သူငယ်ချင်းဆက်ဆံရေး",
    "hsk_level": 5,
    "usage": {
      "title": "朋友之道 (péngyǒu zhī dào) - မိတ်ဆွေဖွဲ့ခြင်း အနုပညာ",
      "meaning": "မိတ်ဆွေအချင်းချင်းကြားတွင် ထားရှိအပ်သော သစ္စာတရား၊ ယုံကြည်မှုနှင့် လေးစားမှုဆိုင်ရာ ကျင့်ဝတ်များ။",
      "grammar_pattern": "讲究 + 朋友之道",
      "daily_examples": [
        {
          "label": "ဖော်ပြခြင်း",
          "chinese": "诚信与互助，是贯穿朋友之道的核心原则。",
          "pinyin": "Chéngxìn yǔ hùzhù, shì guànchuān péngyǒu zhī dào de héxīn yuánzé.",
          "myanmar": "ရိုးသားယုံကြည်မှုနှင့် တစ်ဦးကိုတစ်ဦး ကူညီခြင်းမှာ မိတ်ဆွေဖွဲ့ခြင်း၏ အဓိက အခြေခံမူများ ဖြစ်သည်။"
        },
        {
          "label": "အားပေးခြင်း",
          "chinese": "真正的朋友之道，不在于日常的吃喝玩乐，而在于关键时刻的守望相助。",
          "pinyin": "တကယ့် မိတ်ဆွေစစ်ဆိုတာ နေ့စဉ် ပျော်ရွှင်ရုံတင်မကဘဲ အခက်အခဲကြုံချိန်မှာ အနားမှာ ရှိနေပေးတာပါ။",
          "myanmar": "Zhēnzhèng de péngyǒu zhī dào, bù zàiyú rìcháng de chīhēwánlè, ér zàiyú guānjiàn shíkè de shǒuwàngxiāngzhù."
        }
      ],
      "work_examples": [
        {
          "chinese": "他在同事之间非常讲究朋友之道，这让他赢得了极好的人缘和口碑。",
          "pinyin": "Tā zài tóngshì zhījiān fēicháng jiǎngjiu péngyǒu zhī dào, zhè ràng tā yíngdé le jíbǎo de rényuán hé kǒubēi.",
          "myanmar": "သူသည် လုပ်ဖော်ကိုင်ဖက်များကြားတွင် မိတ်ဆွေပီသစွာ ဆက်ဆံတတ်သဖြင့် လူချစ်လူခင် များလှသည်။"
        }
      ]
    }
