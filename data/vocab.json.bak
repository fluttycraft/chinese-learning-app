    "pinyin": "nàixīn",
    "myanmar": "သည်းခံသော",
    "hsk_level": 4,
    "usage": {
      "title": "耐心 (nàixīn) - စိတ်ရှည်သည်းခံသော / စိတ်ရှည်မှု",
      "meaning": "အခက်အခဲ သို့မဟုတ် ကြာရှည်သော အချိန်များကို စိတ်မတိုဘဲ စောင့်ဆိုင်းနိုင်ခြင်း (Patient/Patience)။",
      "grammar_pattern": "对 Someone + 有耐心 / 耐心 + 地 + Do something",
      "daily_examples": [
        {
          "label": "သည်းခံသော",
          "chinese": "耐心",
          "pinyin": "Nàixīn",
          "myanmar": "စိတ်ရှည်သည် (သို့) သည်းခံသည်"
        },
        {
          "label": "စိတ်ရှည်ပါ",
          "chinese": "请耐心地等一下",
          "pinyin": "Qǐng nàixīn de děng yīxià",
          "myanmar": "ကျေးဇူးပြုပြီး စိတ်ရှည်ရှည်နဲ့ ခဏစောင့်ပေးပါ"
        },
        {
          "label": "စိတ်ရှည်မှု မရှိတော့ဘူး",
          "chinese": "没有耐心了",
          "pinyin": "Méiyǒu nàixīn le",
          "myanmar": "စိတ်မရှည်တော့ဘူး (သို့) သည်းမခံနိုင်တော့ဘူး"
        },
        {
          "label": "အရမ်းစိတ်ရှည်တယ်",
          "chinese": "很有耐心",
          "pinyin": "Hěn yǒu nàixīn",
          "myanmar": "အရမ်းကို စိတ်ရှည်သည်းခံတတ်သည်"
        },
        {
          "label": "စိတ်ရှည်ရှည် ရှင်းပြသည်",
          "chinese": "耐心地解释",
          "pinyin": "Nàixīn de jiěshì",
          "myanmar": "စိတ်ရှည်လက်ရှည် ရှင်းပြသည်"
        }
      ],
      "work_examples": [
        {
          "chinese": "做这件事需要很大的耐心。",
          "pinyin": "Zuò zhè jiàn shì xūyào hěn dà de nàixīn.",
          "myanmar": "ဒီအလုပ်ကို လုပ်ဖို့အတွက် အရမ်းကို စိတ်ရှည်ဖို့ လိုအပ်ပါတယ်။"
        },
        {
          "chinese": "老师对每个同学的要求都非常有耐心。",
          "pinyin": "Lǎoshī duì měi gè tóngxué de yāoqiú dōu fēicháng yǒu nàixīn.",
          "myanmar": "ဆရာက ကျောင်းသားတိုင်းရဲ့ တောင်းဆိုမှုတွေအပေါ်မှာ အရမ်းကို စိတ်ရှည်ရှည်နဲ့ တုံ့ပြန်ပေးပါတယ်။"
        }
      ]
    }
  },
